{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Node 24",
  "_version": "24.0.0",
  "extends": "@tsconfig/node24/tsconfig.json",
  "compilerOptions": {
    "rootDir": ".",
    "erasableSyntaxOnly": true,
    "module": "ESNext",
    "moduleResolution": "bundler",
    "target": "ES2022",
    "lib": [
      "dom",
      "dom.iterable",
      "es2022",
      "ESNext"
    ],
    "jsx": "preserve",
    "allowJs": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "strict": true,
    "forceConsistentCasingInFileNames": true,
    "noFallthroughCasesInSwitch": true,
    "noImplicitAny": false,
    "isolatedModules": true,
    "noEmit": true,
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "#src/*": [
        "./src/*"
      ],
      "#test/*": [
        "./test/*"
      ],
      "@/*": [
        "./src/*"
      ]
    },
    "types": [
      "node",
      "next",
      "react"
    ],
    "resolveJsonModule": true
  },
  "include": [
    "src",
    "cypress",
    "test",
    "cypress/**/*.ts",
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    "next.config.ts"
  ],
  "exclude": [
    "node_modules",
    "dist",
    "build"
  ]
}

{
  "$schema": "https://json.schemastore.org/package",
  "name": "@xhrdev/app",
  "version": "0.0.1",
  "type": "module",
  "private": true,
  "homepage": "https://xhr.dev/",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/xhrdev/app.git"
  },
  "license": "UNLICENSED",
  "author": "XHR Software Inc",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "eslint . --fix",
    "test": "node --import=./test/support/register.mjs --test \"test/**/*.test.ts\" \"test/**/*.test.tsx\"",
    "cypress": "start-server-and-test dev http-get://127.0.0.1:3000 'cypress run'",
    "cypress:run": "cypress run",
    "cypress:open": "BROWSER=none start-server-and-test dev http-get://127.0.0.1:3000 'cypress open'",
    "prepare": "husky",
    "knip": "knip --dependencies"
  },
  "dependencies": {
    "next": "16.4.6",
    "react": "19.3.1",
    "react-dom": "19.3.1"
  },
  "devDependencies": {
    "@commitlint/cli": "21.2.4",
    "@commitlint/config-angular": "21.2.4",
    "@next/eslint-plugin-next": "16.4.6",
    "@skilbjo/config-rc": "1.0.63",
    "@tailwindcss/postcss": "4.3.5",
    "@testing-library/cypress": "10.1.3",
    "@testing-library/dom": "10.4.2",
    "@testing-library/react": "16.3.3",
    "@testing-library/user-event": "14.6.13",
    "@tsconfig/node24": "24.0.6",
    "@types/node": "26.6.6",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "@types/testing-library__cypress": "7.0.0",
    "@types/testing-library__react": "10.2.0",
    "@types/testing-library__user-event": "4.2.0",
    "@typescript-eslint/eslint-plugin": "8.73.0",
    "@typescript-eslint/parser": "8.73.0",
    "@typescript/native-preview": "7.0.0-dev.20260707.2",
    "cypress": "16.3.0",
    "esbuild": "0.28.2",
    "eslint": "10.15.0",
    "eslint-config-next": "16.4.6",
    "eslint-plugin-cypress": "7.1.0",
    "eslint-plugin-n": "18.5.0",
    "eslint-plugin-no-unsanitized": "4.1.5",
    "eslint-plugin-perfectionist": "5.14.0",
    "eslint-plugin-prettier": "5.5.7",
    "eslint-plugin-security": "4.2.1",
    "eslint-plugin-xss": "0.1.12",
    "husky": "9.1.7",
    "jsdom": "31.0.1",
    "knip": "6.47.0",
    "postcss": "8.5.33",
    "prettier": "3.10.1",
    "start-server-and-test": "3.0.13",
    "tailwindcss": "4.3.5"
  },
  "imports": {
    "#src/*": "./src/*",
    "#test/*": "./test/*"
  },
  "engines": {
    "node": ">=26.12.1"
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-angular"
    ]
  },
  "browserslist": [
    "last 2 chrome versions",
    "last 2 firefox versions",
    "last 2 safari versions",
    "last 2 edge versions"
  ],
  "overrides": {
    "minimatch@^10": "11.0.5",
    "eslint-plugin-import-x": {
      "minimatch": "10.2.6"
    }
  }
}
